# ============================================================
# SQL Query AI Agent — Environment Configuration
# Copy this file to .env and fill in the values.
# ============================================================

# ── LLM Provider ─────────────────────────────────────────────
# Which LLM provider to use: "gemini" or "groq"
LLM_PROVIDER=groq

# Optional automatic fallback provider when the primary fails.
# Leave empty to disable fallback.  Example: LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_PROVIDER=

# ── Google Gemini ─────────────────────────────────────────────
# Required when LLM_PROVIDER=gemini (or when used as fallback).
GOOGLE_API_KEY=

# Gemini model name (default: gemini-3.7-flash)
GEMINI_MODEL=gemini-3.7-flash

# ── Groq ─────────────────────────────────────────────────────
# Required when LLM_PROVIDER=groq (or when used as fallback).
GROQ_API_KEY=

# Groq model name
GROQ_MODEL=qwen/qwen3.8-27b

# ── Backend ───────────────────────────────────────────────────
BACKEND_URL=http://127.0.0.1:8000
